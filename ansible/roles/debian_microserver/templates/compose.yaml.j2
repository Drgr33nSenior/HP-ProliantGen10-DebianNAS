# Linux host networking reaches the loopback-only native exporter. Every service
# binds to loopback, apart from the explicitly enabled UniFi syslog receiver.
# An optional intranet proxy provides UI access through a private NAS address.
services:
{% if microserver_telemetry_enabled | bool %}
  tempo:
    image: {{ microserver_tempo_image }}
    user: '10001:10001'
    network_mode: host
    command: [-config.file=/etc/tempo/tempo.yaml]
    environment: {GOMEMLIMIT: 614MiB}
    volumes:
      - /etc/microserver/monitoring/tempo.yaml:/etc/tempo/tempo.yaml:ro
      - /var/lib/microserver/tempo:/var/tempo
    tmpfs: ['/tmp:size=16m,mode=1777']
    mem_limit: 768m
    memswap_limit: 768m
    cpus: 0.25
    pids_limit: 128
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    logging: {driver: local, options: {max-size: 10m, max-file: '3'}}
{% if microserver_telemetry_profiles_enabled | bool %}
  pyroscope:
    image: {{ microserver_pyroscope_image }}
    user: '10001:10001'
    network_mode: host
    # Rings that are configurable only by flag also advertise loopback.
    command:
      - -config.file=/etc/pyroscope/pyroscope.yaml
      - -query-scheduler.ring.instance-addr=127.0.0.1
      - -compactor.ring.instance-addr=127.0.0.1
      - -store-gateway.sharding-ring.instance-addr=127.0.0.1
    environment: {GOMEMLIMIT: 614MiB}
    volumes:
      - /etc/microserver/monitoring/pyroscope.yaml:/etc/pyroscope/pyroscope.yaml:ro
      - /var/lib/microserver/pyroscope:/data
    tmpfs: ['/tmp:size=16m,mode=1777']
    mem_limit: 768m
    memswap_limit: 768m
    cpus: 0.25
    pids_limit: 128
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    logging: {driver: local, options: {max-size: 10m, max-file: '3'}}
{% endif %}
{% endif %}
  prometheus:
    image: {{ microserver_prometheus_image }}
    user: '65534:65534'
    network_mode: host
    command:
      - --config.file=/etc/prometheus/prometheus.yaml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=14d
      - --storage.tsdb.retention.size=24GB
      - --web.listen-address=127.0.0.1:9090
{% if microserver_ui_enabled | bool %}
      - --web.external-url={{ 'https' if microserver_ui_tls_enabled | bool else 'http' }}://prometheus.{{ microserver_ui_domain }}/
{% endif %}
      - --web.enable-remote-write-receiver
      - --query.max-concurrency=2
      - --query.timeout=30s
    environment: {GOMEMLIMIT: 1536MiB}
    volumes:
      - /etc/microserver/monitoring/prometheus.yaml:/etc/prometheus/prometheus.yaml:ro
      - /etc/microserver/monitoring/alerts.yaml:/etc/prometheus/alerts.yaml:ro
{% if microserver_workstation_rules_enabled | bool %}
      - /etc/microserver/monitoring/workstation-alerts.yaml:/etc/prometheus/workstation-alerts.yaml:ro
{% endif %}
      - /var/lib/microserver/prometheus:/prometheus
    mem_limit: 2048m
    memswap_limit: 2048m
    cpus: 0.5
    pids_limit: 256
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    logging: {driver: local, options: {max-size: 10m, max-file: '3'}}
  grafana:
    image: {{ microserver_grafana_image }}
    user: '472:472'
    network_mode: host
    environment:
      GF_SERVER_HTTP_ADDR: 127.0.0.1
{% if microserver_ui_enabled | bool %}
      GF_SERVER_DOMAIN: 'grafana.{{ microserver_ui_domain }}'
      GF_SERVER_ROOT_URL: '{{ "https" if microserver_ui_tls_enabled | bool else "http" }}://grafana.{{ microserver_ui_domain }}/'
{% if microserver_ui_tls_enabled | bool %}
      GF_SECURITY_COOKIE_SECURE: 'true'
{% endif %}
{% endif %}
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana-admin-password
      GF_AUTH_ANONYMOUS_ENABLED: 'false'
      GF_USERS_ALLOW_SIGN_UP: 'false'
      GF_ANALYTICS_REPORTING_ENABLED: 'false'
      GF_ANALYTICS_CHECK_FOR_UPDATES: 'false'
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: 'false'
      GF_PLUGINS_PREINSTALL_DISABLED: 'true'
      GF_PLUGINS_PREINSTALL_AUTO_UPDATE: 'false'
      GF_METRICS_ENABLED: 'true'
    volumes:
      - /etc/microserver/private/grafana-admin-password:/run/secrets/grafana-admin-password:ro
      - /etc/microserver/monitoring/provisioning:/etc/grafana/provisioning:ro
      - /etc/microserver/monitoring/dashboard-folders:/var/lib/grafana/dashboards:ro
      - /var/lib/microserver/grafana:/var/lib/grafana
    tmpfs: ['/tmp:size=64m,mode=1777']
    mem_limit: 2048m
    memswap_limit: 2048m
    cpus: 0.5
    pids_limit: 256
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    logging: {driver: local, options: {max-size: 10m, max-file: '3'}}
  alertmanager:
    image: {{ microserver_alertmanager_image }}
    user: '65534:65534'
    network_mode: host
    command:
      - --config.file=/etc/alertmanager/alertmanager.yaml
      - --storage.path=/alertmanager
      - --web.listen-address=127.0.0.1:9093
{% if microserver_ui_enabled | bool %}
      - --web.external-url={{ 'https' if microserver_ui_tls_enabled | bool else 'http' }}://alertmanager.{{ microserver_ui_domain }}/
{% endif %}
      - --cluster.listen-address=
      - --data.retention=120h
      - --log.level=error
    volumes:
      - /etc/microserver/monitoring/alertmanager.yaml:/etc/alertmanager/alertmanager.yaml:ro
      - /var/lib/microserver/alertmanager:/alertmanager
    mem_limit: 256m
    memswap_limit: 256m
    cpus: 0.1
    pids_limit: 128
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    logging: {driver: local, options: {max-size: 10m, max-file: '3'}}
  loki:
    image: {{ microserver_loki_image }}
    user: '10001:10001'
    network_mode: host
    command: [-config.file=/etc/loki/loki.yaml, -target=all]
    environment: {GOMEMLIMIT: 768MiB}
    volumes:
      - /etc/microserver/monitoring/loki.yaml:/etc/loki/loki.yaml:ro
      - /var/lib/microserver/loki:/loki
    mem_limit: 1024m
    memswap_limit: 1024m
    cpus: 0.2
    pids_limit: 128
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    logging: {driver: local, options: {max-size: 10m, max-file: '3'}}
  vector:
    image: {{ microserver_vector_image }}
    user: '65534:65534'
    network_mode: host
    command: [--config, /etc/vector/vector.yaml, --threads, '1']
    environment: {VECTOR_LOG: warn}
    volumes:
      - /etc/microserver/monitoring/vector.yaml:/etc/vector/vector.yaml:ro
      - /var/lib/microserver/vector:/var/lib/vector
    mem_limit: 256m
    memswap_limit: 256m
    cpus: 0.1
    pids_limit: 64
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    logging: {driver: local, options: {max-size: 10m, max-file: '3'}}
{% if microserver_unifi_metrics_enabled | bool %}
  unpoller:
    image: {{ microserver_unpoller_image }}
    user: '65534:65534'
    network_mode: host
    command: [--config, /etc/unpoller/up.conf]
{% if microserver_unifi_controller_ip | length > 0 %}
    extra_hosts:
      - '{{ microserver_unifi_controller_url | urlsplit("hostname") }}:{{ microserver_unifi_controller_ip }}'
{% endif %}
    environment:
      GOMEMLIMIT: 192MiB
{% if microserver_unifi_custom_ca | bool %}
      SSL_CERT_FILE: /run/secrets/unifi-ca.pem
{% endif %}
    volumes:
      - /etc/microserver/monitoring/unpoller.conf:/etc/unpoller/up.conf:ro
      - /etc/microserver/private/unifi-credential:/run/secrets/unifi-credential:ro
{% if microserver_unifi_custom_ca | bool %}
      - /etc/microserver/private/unifi-ca.pem:/run/secrets/unifi-ca.pem:ro
{% endif %}
    mem_limit: 256m
    memswap_limit: 256m
    cpus: 0.1
    pids_limit: 64
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    logging: {driver: local, options: {max-size: 10m, max-file: '3'}}
{% endif %}
