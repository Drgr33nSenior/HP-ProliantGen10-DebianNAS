{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },
  "http": {
    "address": "127.0.0.1",
    "port": {{ microserver_registry_port | string | to_json }},
    "compat": ["docker2s2"],
    "readTimeout": {{ (microserver_registry_transfer_timeout_seconds | int | string ~ "s") | to_json }},
    "writeTimeout": {{ (microserver_registry_transfer_timeout_seconds | int | string ~ "s") | to_json }},
    "auth": {
      "htpasswd": {"path": "/etc/zot/htpasswd"},
      "failDelay": 5
    },
    "accessControl": {
      "repositories": {
        "local/**": {
          "anonymousPolicy": ["read"],
          "policies": [{"users": [{{ microserver_registry_publisher | to_json }}], "actions": ["read", "create", "update", "delete"]}]
        },
        "**": {"anonymousPolicy": ["read"]}
      }
    }
  },
  "log": {"level": "info"},
  "extensions": {
    "search": {"enable": true},
    "ui": {"enable": true},
    "sync": {
      "enable": true,
      "registries": [
{% for upstream in microserver_registry_upstreams %}
        {
          "urls": [{{ upstream.url | to_json }}],
          "onDemand": true,
          "tlsVerify": true,
          "platforms": ["linux/amd64"],
          "maxRetries": 3,
          "retryDelay": "10s",
          "content": [{"prefix": "**", "destination": {{ ('/' ~ upstream.prefix) | to_json }}}]
        }{{ ',' if not loop.last else '' }}
{% endfor %}
      ]
    }
  }
}
