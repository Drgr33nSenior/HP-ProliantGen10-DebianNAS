global:
  scrape_interval: 30s
  evaluation_interval: 30s
rule_files: [/etc/prometheus/alerts.yaml]
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:9093']
scrape_configs:
  - job_name: microserver-node
    static_configs:
      - targets: ['127.0.0.1:9100']
  - job_name: microserver-prometheus
    static_configs:
      - targets: ['127.0.0.1:9090']
  - job_name: microserver-grafana
    static_configs:
      - targets: ['127.0.0.1:3000']
  - job_name: microserver-loki
    scrape_interval: 60s
    static_configs:
      - targets: ['127.0.0.1:3100']
  - job_name: microserver-vector
    scrape_interval: 60s
    static_configs:
      - targets: ['127.0.0.1:8687']
{% if microserver_unifi_metrics_enabled | bool %}
  - job_name: microserver-unifi
    scrape_interval: 60s
    scrape_timeout: 10s
    static_configs:
      - targets: ['127.0.0.1:9130']
    # Exact families used by the overview and the four pinned Insights dashboards.
    metric_relabel_configs:
      - source_labels: [__name__]
        action: keep
        regex: '{{ microserver_unifi_metrics | join("|") }}'
{% endif %}
