global:
  scrape_interval: 30s
  evaluation_interval: 30s
rule_files: [/etc/prometheus/alerts.yaml]
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:9093']
scrape_configs:
  - job_name: microserver-node
    static_configs:
      - targets: ['127.0.0.1:9100']
  - job_name: microserver-prometheus
    static_configs:
      - targets: ['127.0.0.1:9090']
  - job_name: microserver-grafana
    static_configs:
      - targets: ['127.0.0.1:3000']
  - job_name: microserver-loki
    scrape_interval: 60s
    static_configs:
      - targets: ['127.0.0.1:3100']
  - job_name: microserver-vector
    scrape_interval: 60s
    static_configs:
      - targets: ['127.0.0.1:8687']
{% if microserver_unifi_metrics_enabled | bool %}
  - job_name: microserver-unifi
    scrape_interval: 60s
    scrape_timeout: 10s
    static_configs:
      - targets: ['127.0.0.1:9130']
    # Store the metrics used by the overview, not per-client or DPI series.
    metric_relabel_configs:
      - source_labels: [__name__]
        action: keep
        regex: 'unifipoller_(controller_up|prometheus_cache_age_seconds|prometheus_refresh_failures_total|device_(cpu_utilization_ratio|memory_utilization_ratio|temperature_celsius|uptime_seconds|wan_(receive_bytes_total|transmit_bytes_total|latency_seconds|status)))'
{% endif %}
