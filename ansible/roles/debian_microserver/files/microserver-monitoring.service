[Unit]
Description=MicroServer local monitoring containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/microserver
ConditionPathExists=/etc/microserver/private/grafana-admin-password

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/microserver/monitoring
ExecStartPre=/usr/bin/docker-compose --project-name microserver --file compose.yaml config --quiet
ExecStart=/usr/bin/docker-compose --project-name microserver --file compose.yaml up --detach
ExecReload=/usr/bin/docker-compose --project-name microserver --file compose.yaml up --detach --force-recreate
ExecStop=/usr/bin/docker-compose --project-name microserver --file compose.yaml stop
TimeoutStartSec=600
TimeoutStopSec=90
UMask=0077

[Install]
WantedBy=multi-user.target
