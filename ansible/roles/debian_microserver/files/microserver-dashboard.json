{
  "uid": "microserver",
  "title": "MicroServer",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["microserver", "storage"],
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "CPU busy", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"microserver-node\",mode=\"idle\"}[5m])))"}]
    },
    {
      "id": 2, "title": "Memory used", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"microserver-node\"} / node_memory_MemTotal_bytes{job=\"microserver-node\"})"}]
    },
    {
      "id": 3, "title": "Filesystem space used", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "targets": [{"refId": "A", "legendFormat": "{{mountpoint}}", "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"microserver-node\",fstype=~\"ext4|xfs|zfs|btrfs\"} / node_filesystem_size_bytes{job=\"microserver-node\",fstype=~\"ext4|xfs|zfs|btrfs\"})"}]
    },
    {
      "id": 4, "title": "Disk reads and writes", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}},
      "targets": [
        {"refId": "A", "legendFormat": "{{device}} read", "expr": "rate(node_disk_read_bytes_total{job=\"microserver-node\"}[5m])"},
        {"refId": "B", "legendFormat": "{{device}} write", "expr": "rate(node_disk_written_bytes_total{job=\"microserver-node\"}[5m])"}
      ]
    }
  ]
}
